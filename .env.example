# SMTP configuration for enquiry emails
# Gmail example: smtp.gmail.com + port 465 + SMTP_SECURE=true
# Use a Gmail App Password rather than your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-16-character-app-password
ENQUIRY_TO=scorpytechs@gmail.com
PORT=5000
